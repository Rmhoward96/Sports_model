# Copy to .env and fill in. .env is gitignored.

# --- Local warehouse (DuckDB + Parquet) ---
# Defaults are fine; override only to relocate.
# SM_DATA_DIR=./data
# SM_DUCKDB_PATH=./data/warehouse.duckdb

# --- Backfill depth ---
# Statcast full pitch-tracking is reliable from 2015.
SM_STATCAST_START_SEASON=2015

# --- Supabase Postgres (serving layer; gold + dims + staging) ---
# Session pooler / connection string from your Supabase project settings.
# Leave unset to run fully local (DuckDB only) for now.
# DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres

# --- The Odds API (odds snapshots for CLV backtesting) ---
# Key from the-odds-api.com. Props are per-event and consume credits fast.
# ODDS_API_KEY=your_key_here
# INGEST_PROPS=true   # set false to capture only game lines and save credits
