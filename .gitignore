# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/

# Env / secrets
.env

# Data warehouse + raw parquet (regenerable; never commit)
data/
*.duckdb
*.duckdb.wal
*.parquet

# Exception: small rate-profile snapshots the hosted prediction job reads
!assets/profiles/
!assets/profiles/*.parquet

# Exception: committed advancement table the simulator reads
!assets/advancement/
!assets/advancement/*.parquet

# Exception: committed nflverse snapshots (schedules/weekly/rosters/injuries)
!assets/nfl/
!assets/nfl/*.parquet

# Exception: committed CFB schedule snapshot (ESPN, used by elo/srs ratings)
!assets/cfb/
!assets/cfb/*.parquet

# OS
.DS_Store
